# ==============================================================================
# C/C++ Embedded Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Outputs & Compiled Objects
# ------------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.out
*.elf
*.hex
*.bin
*.map
*.axf
*.d
*.dep
*.crf
*.lnp
*.lst
*.m51
*.omf
*.plg
*.sct
*.htm
*.build_log.htm

# Output Directories
/build/
/bin/
/obj/
/out/
Project/build/
Debug/
Release/

# ------------------------------------------------------------------------------
# Keil MDK-ARM Specific
# ------------------------------------------------------------------------------
*.uvoptx
*.uvopt
*.uvguix.*
*.JLinkScript
JLinkLog.txt
*.iex
*.ini
*.TMP

# ------------------------------------------------------------------------------
# EIDE & CMSIS Specific
# ------------------------------------------------------------------------------
.eide/
EIDE/.eide/
.eide.usr.ctx.json
EIDE/.eide.usr.ctx.json
*.ept
*.eide-template
.cmsis/
EIDE/.cmsis/
EIDE/.pack/
.clangd/

# ------------------------------------------------------------------------------
# IDE / Editor (VS Code, Visual Studio, etc.)
# ------------------------------------------------------------------------------
.vscode/
.idea/
.vs/
.omo/
.clang-format
.clangd/
.clangd
*.code-workspace
*.swp
*~
*.bak
*.tmp

# User-specific workspace files (uncomment to track if shared across team)
# *.code-workspace

# ------------------------------------------------------------------------------
# OS Generated
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# AI / agent artifacts
# ------------------------------------------------------------------------------
.opencode/
.sisyphus/
.codegraph/
.reasonix/
.workbuddy/
AGENTS.md
reasonix.toml

# ------------------------------------------------------------------------------
# Exceptions — 以下文件命中上方通配规则但必须跟踪
# ------------------------------------------------------------------------------
!Middlewares/emWin/src/*.lib        # emWin 官方库，编译必需
!Project/MDK-ARM/*.sct              # 链接脚本，链接必需
!Project/MDK-ARM/script/*.exe       # Lua 运行时，构建脚本依赖
!Project/MDK-ARM/script/*.dll       # Lua 运行时动态库
!Project/MDK-ARM/JLinkSettings.ini  # JLink 调试配置
!Project/MDK-ARM/*.uvoptx           # Keil 项目选项（调试器/Flash Download 等配置，团队共享）
